# Copy to .env and edit. Everything has a working default for --offline / local compose.
AEGIS_ENV=dev
AEGIS_OFFLINE=false
AEGIS_LOG_LEVEL=INFO
AEGIS_SEED=1337

# Elasticsearch (lab SIEM). The agent uses the READ-ONLY key; loaders use the WRITER key (§9.1).
AEGIS_ES_URL=http://localhost:9200
AEGIS_ES_KIBANA_URL=http://localhost:5601
# AEGIS_ES_READONLY_API_KEY=
# AEGIS_ES_WRITER_API_KEY=
AEGIS_ES_INDEX_PREFIX=aegis
AEGIS_ES_VERIFY_CERTS=false

# Postgres / Redis (docker-compose defaults)
AEGIS_PG_DSN=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
AEGIS_REDIS_URL=redis://localhost:6379/0

# Data layout
# AEGIS_DATA_ROOT=./data

# Public datasets that need a manual export/registration (see loader docstrings)
# AEGIS_BOTS_EXPORT=./data/raw/bots/botsv1.json

# Telemetry -> Lens (optional; empty = disabled)
# AEGIS_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---- LLM reasoner (COST.md: free providers only; paid ones refused unless AEGIS_ALLOW_PAID_PROVIDERS=1)
AEGIS_LLM_PROVIDER=auto            # auto | ollama | groq | gemini | none
AEGIS_OLLAMA_URL=http://localhost:11434
# AEGIS_LLM_MODEL=llama3.1:8b
# GROQ_API_KEY=
# GEMINI_API_KEY=
AEGIS_LLM_TIMEOUT_S=180
BUDGET_LLM_CALLS_PER_RUN=60
BUDGET_LLM_TOKENS_PER_DAY=300000
BUDGET_EXTERNAL_CALLS_PER_DAY=2000

# ---- Case memory (Evorozen Neural Pulse; metadata only, see SECURITY.md)
AEGIS_MEMORY_BACKEND=auto          # auto | pulse | local
# AEGIS_PULSE_API_KEY=
AEGIS_PULSE_BASE_URL=https://pulse.evorozen.com
BUDGET_PULSE_CALLS_PER_DAY=40
AEGIS_TENANT=lab
# AEGIS_TENANT_SALT=change-me

# ---- Review API / UI
# AEGIS_AUTH_SECRET=              # long random string in production
AEGIS_UI_URL=http://localhost:3000
# NEXT_PUBLIC_UMAMI_SRC=          # self-hosted Umami, optional
# NEXT_PUBLIC_UMAMI_ID=
