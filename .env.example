# Copy to .env and edit. Everything has a working default for --offline / local compose.
AEGIS_ENV=dev
AEGIS_OFFLINE=false
AEGIS_LOG_LEVEL=INFO
AEGIS_SEED=1337

# Elasticsearch (lab SIEM). The agent uses the READ-ONLY key; loaders use the WRITER key (§9.1).
AEGIS_ES_URL=http://localhost:9200
AEGIS_ES_KIBANA_URL=http://localhost:5601
# AEGIS_ES_READONLY_API_KEY=
# AEGIS_ES_WRITER_API_KEY=
AEGIS_ES_INDEX_PREFIX=aegis
AEGIS_ES_VERIFY_CERTS=false

# Postgres / Redis (docker-compose defaults)
AEGIS_PG_DSN=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
AEGIS_REDIS_URL=redis://localhost:6379/0

# Data layout
# AEGIS_DATA_ROOT=./data

# Public datasets that need a manual export/registration (see loader docstrings)
# AEGIS_BOTS_EXPORT=./data/raw/bots/botsv1.json

# Telemetry -> Lens (optional; empty = disabled)
# AEGIS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
